# ---- server -------------------------------------------------------------
PORT=5000
# Comma-separated list of origins the browser app is served from.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Used in emails (reset links, order links) and as a CORS fallback.
FRONTEND_URL=http://localhost:5173

# ---- database -----------------------------------------------------------
# MongoDB Atlas connection string (or a local mongod):
MONGO_URI=mongodb://127.0.0.1:27017/nari-craft
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nari-craft?retryWrites=true&w=majority

# ---- auth ---------------------------------------------------------------
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string-of-at-least-32-characters
# Google Sign-In client id (same value as VITE_GOOGLE_CLIENT_ID in the front end).
GOOGLE_CLIENT_ID=

# ---- email (Resend) -----------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=Nari Craft <orders@example.com>

# ---- payments (Payments.lk) --------------------------------------------
PAYMENTS_LK_SECRET_KEY=
PAYMENTS_LK_WEBHOOK_SECRET=
